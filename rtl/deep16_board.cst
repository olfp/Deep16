// deep16_board.cst - Tang Nano 9K (GW1NR-LV9QN88PC6/I5) pin constraints.
//
// D16MINI.md §4.5. Five pins: the 27 MHz oscillator, the reset button, the two
// UART pins of the on-board USB bridge, and one LED.
//
// CONFIRM EVERY PIN against the Sipeed Tang Nano 9K pinout and the board
// schematic before the first build. There is no board and no Gowin toolchain
// here, so these are the documented values, not a measured ones. The UART pair
// in particular decides whether the console works at all.

// 27 MHz oscillator
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S1 button, active low. Pin 4 is bank 3, whose VCCIO the device fixes (the
// embedded port locks it), so no IO_TYPE here - Sipeed's own Tang Nano 9K
// constraints (picotiny.cst) omit it for this pin. Stating LVCMOS33 fails
// place & route with CT1136, "Bank 3 vccio(1.8) is locked".
IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP;

// S2 button, active low, also bank 3.
IO_LOC "btn" 3;
IO_PORT "btn" PULL_MODE=UP;

// USB-UART bridge (the debugger chip): FPGA TX -> bridge RX, bridge TX -> FPGA RX
IO_LOC "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "uart_rxd" 18;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// PS/2 keyboard. These are the 3.3 V side of the external level shifter; the
// keyboard side is 5 V open-collector. Pins 76/77 are on the J6 header and in
// the 3.3 V bank. Both are inputs to the FPGA; the design never drives them.
IO_LOC "ps2_clk" 76;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "ps2_data" 77;
IO_PORT "ps2_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// SPI. Pins 36..39 are the on-board microSD socket (SCLK, MOSI, CS0, MISO),
// 3.3 V; the SD card is driven in SPI mode. The on-board 4 MB configuration
// flash (Puya P25Q32U) is the second target, on the MSPI pins 59..62, reused
// as GPIOs after configuration (set_option -use_mspi_as_gpio 1). FPGA pin 25
// is no longer CS1; it is free for the I2S BCLK (J5 pin 5).
IO_LOC "spi_sck" 36;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_mosi" 37;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_cs_n" 38;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "spi_miso" 39;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Config flash, MSPI pins. The FPGA drives MCLK/MO/MCS_N after DONE; MI is an
// input. These are the pins the FPGA itself uses to configure, so the design
// must never drive them before the configuration is complete (the tool's MSPI
// regular-IO option handles the handover).
IO_LOC "cfg_sck" 59;
IO_PORT "cfg_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "cfg_cs_n" 60;
IO_PORT "cfg_cs_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "cfg_mosi" 61;
IO_PORT "cfg_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "cfg_miso" 62;
IO_PORT "cfg_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// On-board LEDs. The six are on pins 10/11/13/14/15/16; all are bank 3 like
// the button, so no IO_TYPE. Active low.
IO_LOC "led[0]" 10;
IO_PORT "led[0]" DRIVE=8;
IO_LOC "led[1]" 11;
IO_PORT "led[1]" DRIVE=8;
IO_LOC "led[2]" 13;
IO_PORT "led[2]" DRIVE=8;
IO_LOC "led[3]" 14;
IO_PORT "led[3]" DRIVE=8;
IO_LOC "led[4]" 15;
IO_PORT "led[4]" DRIVE=8;
IO_LOC "led[5]" 16;
IO_PORT "led[5]" DRIVE=8;

// I2S output to the MAX98357A on J5 5/6/7 (BCLK/LRCLK/DIN). Pin 25 was the
// second SPI CS before the config flash moved to the MSPI pins 59..62.
IO_LOC "i2s_bclk" 25;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "i2s_lrclk" 26;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "i2s_din" 27;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 DRIVE=8;

// HDMI/DVI output (Tang Nano 9K pins). Lane 0 = blue, 1 = green, 2 = red,
// 3 = clock. The ELVDS_OBUF primitive drives the n side, so only the p pin of
// each pair is constrained (the same convention as the upstream example).
IO_LOC "hdmi_tx_p[0]" 71,70;
IO_PORT "hdmi_tx_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "hdmi_tx_p[1]" 73,72;
IO_PORT "hdmi_tx_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "hdmi_tx_p[2]" 75,74;
IO_PORT "hdmi_tx_p[2]" PULL_MODE=NONE DRIVE=8;
IO_LOC "hdmi_tx_p[3]" 69,68;
IO_PORT "hdmi_tx_p[3]" PULL_MODE=NONE DRIVE=8;
