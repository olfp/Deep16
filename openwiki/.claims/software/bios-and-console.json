    {
      "id": "claim_f1f3610b133542f091c183fc5ec08110",
      "statement": "One BIOS interface serves the screen and UART consoles: the default build writes cells at 0xF1000, the CONSOLE_UART build writes UART bytes, and the D16nano build adds gfx as function 6; the kernel is unchanged between them.",
      "evidence": [
        {
          "resource": "repo://asm/forth.asm#L13013-L13020",
          "version": "repo-lines-v1:sha256:5ef6461350f9ebfdb1beec713abad706ccdc53bdfc6b14ada043e0b33b8682d0:"
