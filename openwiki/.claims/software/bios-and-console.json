    {
      "id": "claim_15769bcfbcae4b4790ae6dea513da1d5",
      "statement": "Screen getstr polls the keyboard port, reads the echo cell 0xF0064 once per keystroke, ends the line on CR or LF, and handles backspace by rewinding the buffer pointer and erasing the cell.",
