    {
      "id": "claim_2f758e3e58804f0d8a3a24a93c109fba",
      "statement": "Screen putch handles CR and LF specially; other characters clear the old cursor attribute, store the character, advance SCR, scroll when SCR reaches the off-screen row 0x1780, and mark the new cursor cell with 0x7000 built as 0x0070 shifted left by 8.",
      "evidence": [
        {
          "resource": "repo://asm/forth.asm#L13538-L13607",
          "version": "repo-lines-v1:sha256:ad3dbf3a642d93e755f06a6b977f19bc112c90e420a75d9c5a26fe08bad980b9:"
