    {
      "id": "claim_f5e98ba5e8c041a8ac36fa057b8c0109",
      "statement": "Screen putstr copies bytes into consecutive cells without the cursor bookkeeping; getch polls KBD_STATUS at 0xF0060 and pops KBD_DATA at 0xF0062, masking to eight bits.",
      "evidence": [
        {
          "resource": "repo://asm/forth.asm#L13694-L13735",
          "version": "repo-lines-v1:sha256:a4ee60dc59465808ce8878aceafb9f9489b474c90325193a40931e3590d5bff6:"
