        }
      ]
    },
    {
      "id": "claim_c25ca8e56cb24437bc4a7c7369f0bce4",
      "statement": "BIOS calls pass the function number in the caller's R0 and parameters in R1-R3; the handler reaches them through the shadow bank with SMV and leaves the result in its own R0, which the caller reads with SMV Rx, AR0 because RETI copies nothing.",
      "evidence": [
        {
          "resource": "repo://asm/forth.asm#L13019-L13057",
          "version": "repo-lines-v1:sha256:ee71937a23c3163cb2c348b8843fd63b190bdc96115ae4c48fba33086c2619c7:"
        }
      ]
    },
    {
      "id": "claim_062e4df580a7465ebf4d0aa1d872ef92",
      "statement": "Dispatch is a six-entry jump table with an explicit out-of-range path, covering bver, binit, putch, putstr, getch and getstr.",
