    {
      "id": "claim_a88b027e4112422e84bcc6365cfaf020",
      "statement": "Deep16 is a 16-bit RISC ISA with three interchangeable cores (JS reference, Rust/WASM, and a Verilator RTL microarchitecture), and the JS core is the golden reference the others are held to.",
      "evidence": [
        {
          "resource": "repo://README.md#L1-L19",
          "version": "repo-lines-v1:sha256:108067032538f6053d74a57dbf5cfced56b5f7f1710c906b2e830d1b78d15b34:"
        }
      ]
    },
    {
      "id": "claim_c55fa5adeaa046c4b496ae29d3d2686b",
      "statement": "The machine has 16 general registers with R15 as PC, a 20-bit word address space of 1M words, CS/DS/SS/ES segmentation with phys = (segment << 4) + offset, a shadow bank swapped while PSW bit 5 is set, 16-bit instructions, and a 16-word boot ROM at 0xFFFF0 jumping to 0x0100.",
      "evidence": [
        {
          "resource": "repo://README.md#L171-L185",
          "version": "repo-lines-v1:sha256:b497788b959bafebdf79bda57f696bbb95acae0f244713dae04ce2fc75877690:"
