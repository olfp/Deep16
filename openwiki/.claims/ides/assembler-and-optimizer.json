        }
      ]
    },
    {
      "id": "claim_0106f0ebd76346f4b9b8e0f10e59c07d",
      "statement": "The ALU immediate field is a 4-bit value 0..15; ADD/SUB/CMP treat it as a literal while TBC/OR/XOR/TBS/CLRB treat it as a bit index that the core expands to 1<<imm.",
      "evidence": [
        {
          "resource": "repo://js/deep16_assembler.js#L1240-L1262",
          "version": "repo-lines-v1:sha256:bc64cc682964f1ccc163b19c159669c3fd68d38428038bc8adf07020db03c961:"
        }
      ]
    },
    {
      "id": "claim_3eff2e5cc72c4fbf804a1f0685053396",
      "statement": "AND has no immediate form because that slot belongs to CLRB, and CLRB rejects a register operand and requires an immediate bit number.",
      "evidence": [
        {
          "resource": "repo://js/deep16_assembler.js#L1212-L1232",
          "version": "repo-lines-v1:sha256:ecf42f4c12cbc993eab0639e8074eca65a364ec400117cedf11c04eae08b366e:"
        }
      ]
    },
    {
      "id": "claim_1fc81393d1f64530b21adee424e18dce",
      "statement": "MUL32 and DIV32 require an even destination register because the 32-bit result occupies Rd:Rd+1.",
