    {
      "id": "claim_6c7f1fe388854cac977c1195115e5ae9",
      "statement": "LDI accepts a 15-bit pattern in either spelling, 0..0x7FFF or -16384..-1, and rejects anything else, because the CPU sign-extends bit 14.",
      "evidence": [
        {
          "resource": "repo://js/deep16_assembler.js#L1346-L1372",
          "version": "repo-lines-v1:sha256:bcccbcabe5af0ba91be390670a14d19f556e1a30bf9bb6080867b06b5ccaba4d:"
        }
      ]
    },
    {
      "id": "claim_64187b048375480e8bf6d869f6eb7556",
      "statement": "LWI is an assembler-only mnemonic that emits the LDI field sign-extending to a 16-bit pattern, refuses patterns in 0x4000-0xBFFF, and suggests loading the low 14 bits then setting bits 14/15 with OR.",
      "evidence": [
        {
          "resource": "repo://js/deep16_assembler.js#L1375-L1403",
          "version": "repo-lines-v1:sha256:0d2d5e8f16c08817b225610a138a31feefe86d822601df0d35689f3fa47f0b13:"
        },
        {
