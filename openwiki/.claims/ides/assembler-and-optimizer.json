    {
      "id": "claim_a33fbb8a2e624fb7904a1f5208ba0f79",
      "statement": ".equ binds everything after the name as one expression, so '.equ D, f0 - f1' keeps both symbols, and a register value becomes a register alias instead of a constant.",
