    {
      "id": "claim_48ccb4a08e764e379b4daa07d34c4bea",
      "statement": "PSW bits 0-3 are N, Z, V and C, bit 4 is interrupt enable, bit 5 selects the shadow bank, bits 6-10 select the stack segment register, and bits 11-15 select the extra segment register.",
