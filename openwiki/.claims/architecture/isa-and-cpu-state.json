        }
      ]
    },
    {
      "id": "claim_d9b38d9d254f40438994f9f7d3ed526a",
      "statement": "LDI sign-extends bit 14 of its 15-bit field, so it can reach 0x0000-0x3FFF and 0xC000-0xFFFF but not the two middle quarters of the 16-bit space.",
      "evidence": [
        {
          "resource": "repo://doc/Deep16-Arch.md#L315-L348",
          "version": "repo-lines-v1:sha256:8a7dbf5b050d5574648f9ca52b85c2377e718586cabbb98557faf06bfdc58e47:"
        }
