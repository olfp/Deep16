    {
      "id": "claim_2185bc74b54f442b8199e5c493cdd39a",
      "statement": "LD/ST use a sign-extended 5-bit offset and choose SS, ES or DS according to the PSW stack/extra register selectors, while LDS/STS name the segment explicitly.",
