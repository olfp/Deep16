    {
      "id": "claim_6de37b01e70d4dc5b82d54e1ef5c9672",
      "statement": "Deep16 uses 16-bit words in a 20-bit address space, computes physical addresses as (segment << 4) + offset, and resets with CS=0xFFFF and PC=0 to execute the boot ROM at 0xFFFF0.",
