        {
          "resource": "repo://doc/Deep16-Arch.md#L104-L126",
          "version": "repo-lines-v1:sha256:a5fa0314ce77531314da2216a5a7e012ad0e9752a572d885680c5174fb5b6443:"
        }
      ]
    },
    {
      "id": "claim_14f38f410782482198487943cd850f2a",
      "statement": "Instruction groups are selected by a prefix hierarchy from one-bit LDI through 13-bit SYS, followed by reserved FPU/FCMP encodings and the all-ones halt word.",
