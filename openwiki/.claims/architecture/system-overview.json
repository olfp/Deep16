    {
      "id": "claim_64620a9cc2b847a9a2cfea85e7a9e5a2",
      "statement": "Deep16 is a 16-bit RISC ISA with three interchangeable cores: a JavaScript behavioural reference, a Rust/WASM port, and a SystemVerilog RTL pipeline.",
      "evidence": [
        {
          "resource": "repo://README.md#L1-L16",
          "version": "repo-lines-v1:sha256:70f54abf9ceb45e3c285792429df1ba044395021ca1ab13df34318317f395d28:"
        }
      ]
    },
    {
      "id": "claim_85621c858ace4498999ea38cba161b3b",
      "statement": "The JavaScript core is the golden reference; the WASM and RTL cores are held to it by tests that compare instruction-by-instruction.",
      "evidence": [
        {
          "resource": "repo://README.md#L13-L18",
          "version": "repo-lines-v1:sha256:799f196b87eeee27d34e85b07af2ce4db75c678a4fb4d4b4837b480cf4a7b349:"
