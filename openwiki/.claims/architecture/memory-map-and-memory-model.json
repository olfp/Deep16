        }
      ]
    },
    {
      "id": "claim_7d9d171033c84d3da3aacc2eb2b1f729",
      "statement": "The common MMIO map places the timer at 0xF0020, the UART at 0xF0040, the keyboard at 0xF0060, the cycle counter at 0xF0068, SPI at 0xF0080, I2S and SIC at 0xF00A0-0xF00BF, and the display window at 0xF1000.",
      "evidence": [
