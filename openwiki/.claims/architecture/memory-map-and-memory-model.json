        }
      ]
    },
    {
      "id": "claim_ea8901785f2d4e0684e830c3e015a91f",
      "statement": "Deep16 has three build profiles: a 1 MiB flat screen/IDE build, a 24K-word PSRAM-backed D16MINI UART build, and a 24K-word config-flash D16nano tile build, with different BIOS entries, dictionary ceilings and stack tops.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L45-L68",
          "version": "repo-lines-v1:sha256:6ac38fafc3688590278de954a59eb8f9890cde84598f963bb6796ca09ae918f2:"
        }
      ]
    },
    {
      "id": "claim_19f37d10bcff4c26b8799e44aead328a",
      "statement": "The D16MINI and D16nano kernels probe word 0x6000 after boot and, when PSRAM responds, move the dictionary there and raise its ceiling to 0xFFF0.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L60-L68",
          "version": "repo-lines-v1:sha256:91697a91cf30c8602b0196fcdaef6059bd1ffa09e4d30cc8bd1c2c4fc6b91a33:"
        }
      ]
    },
    {
