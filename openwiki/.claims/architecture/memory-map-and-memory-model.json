  "claims": [
    {
      "id": "claim_7889a2aa411f4d35a91ec1528555bfc5",
      "statement": "Deep16 addresses 16-bit words in a 20-bit space using (segment << 4) + offset; unbacked reads return 0xFFFF and unbacked writes are dropped.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L21-L40",
          "version": "repo-lines-v1:sha256:14eedeb17501d52487ae8ef4598e286e2aa22d5d9844f611eda307540ad5d0ce:"
        }
      ]
    },
    {
      "id": "claim_d70bfb10d61c406489a523989a6debdd",
      "statement": "The ILL, hardware-IRQ and SWI vectors sit at physical 0x0000, 0x0001 and 0x0002, and the boot ROM at 0xFFFF0 jumps to 0000:0100 after planting that entry at physical 0-2.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L36-L42",
          "version": "repo-lines-v1:sha256:67aef3ce134082f1a8b671e267076cfca583878933783814a2938d40a3ccb35b:"
