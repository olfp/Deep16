    {
      "id": "claim_9d168ae6433446faa286a009450371fa",
      "statement": "The current board's PSRAM path uses psram_word_bridge and the open-source psram_controller at 51 MHz, one word per transaction with an optional two-word burst; deep16_psram_bridge is the alternative Gowin HS-IP path and is not in the project file list.",
      "evidence": [
        {
          "resource": "repo://fpga/gowin/deep16_board_tile_flash.gprj#L17-L24",
          "version": "repo-lines-v1:sha256:60869638c2e4f9cb83cf42b6227fd71d39c958a3ee6faea6f89d0740e50655dc:"
        },
        {
          "resource": "repo://rtl/psram/deep16_psram_bridge.sv#L1-L16",
          "version": "repo-lines-v1:sha256:aad86e20f6ed77689eb5c416c9b2e4b1dc89214d35f9f2c14a014682d56ec080:"
        },
        {
          "resource": "repo://rtl/psram/psram_word_bridge.sv#L1-L14",
          "version": "repo-lines-v1:sha256:4f7e9ffc37dce19f7199bb885207bb74a7d95ed74ed40b273f975494a2c118c9:"
        }
      ]
    },
    {
      "id": "claim_32b96e0c6b784da08f4c26ce830de821",
      "statement": "PSRAM requests cross clock domains as toggles with stable payloads, and the controller receives a 22-bit byte address derived from the 20-bit word address.",
      "evidence": [
        {
          "resource": "repo://rtl/psram/psram_word_bridge.sv#L1-L60",
          "version": "repo-lines-v1:sha256:febed73706973366b79d6c60027fba26098ed4acf489d54f251763438b5add9c:"
        }
      ]
    },
    {
      "id": "claim_c93c1dd0af6346a3b6ac92062482ccab",
      "statement": "The cache is 512 direct-mapped two-word lines: 1024 words of data in one BSRAM block plus 512 tags in a second, split as tag bits 19:10, line bits 9:1 and word bit 0.",
      "evidence": [
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L1-L20",
          "version": "repo-lines-v1:sha256:73f5c215547c6f9b4c83c0589800eedcec65e4d7d2f8d27a19ffe3a20308972d:"
        },
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L124-L138",
          "version": "repo-lines-v1:sha256:2842aa3bec8916d503813f5b02db30928a25e6b8025c1f31bb1a4f5ea394d7f7:"
        }
      ]
    },
    {
      "id": "claim_b135235fd4ce4546b2ca35152b660d36",
      "statement": "The cache is write-through with update on hit, so it always matches PSRAM and FSH only has to clear tags; 0xFFFF0-0xFFFFF is served from a local boot-ROM constant instead of PSRAM.",
      "evidence": [
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L440-L452",
          "version": "repo-lines-v1:sha256:dcf23419080feb45dd5fea8bc7438c3e61b6919e450c830f238542a55e8633a9:"
        },
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L7-L18",
          "version": "repo-lines-v1:sha256:02ff27c0b52a15cff8898b382d7f297526e45e2c56709763549543aad86dd485:"
        }
      ]
    },
    {
      "id": "claim_136f6563b0be4b9d84fe825ef99d4d31",
      "statement": "Two-word lines are chosen because a burst fill costs one transaction while a longer line would make a first pass through fresh code slower than an uncached machine.",
      "evidence": [
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L474-L492",
          "version": "repo-lines-v1:sha256:b90b8644b901913bdd717c5971b6148d7d49c6b21504138e346c9bad1eefa956:"
        },
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L9-L13",
          "version": "repo-lines-v1:sha256:3c65b23e4da9b9e039d06cd81154ebd293638d7fbc829398c547319fe8aa0882:"
        }
      ]
    },
    {
      "id": "claim_50e9dd115772408fae643d025fcbc4ee",
      "statement": "Cache line fill writes the two words on consecutive cycles because two different addresses on one clock edge cannot be inferred as BSRAM.",
      "evidence": [
        {
          "resource": "repo://rtl/psram/deep16_psram_mem.sv#L481-L500",
          "version": "repo-lines-v1:sha256:461443add7204f1fe9ec7420d5b46e84178873ef50d26edbe0d5e06785bd3d8f:"
        }
      ]
    },
    {
      "id": "claim_4f0a2945a575436f9ecf0e3e163c3248",
      "statement": "Memory service order is store, then load, then fetch: a retiring store is latched first and written through to PSRAM even on a cache hit.",
