        }
      ]
    },
    {
      "id": "claim_6dde4567cdd94c029f9506156a98783f",
      "statement": "The SIC source vector is {raster, audio, timer, keyboard}; the timer tick drives bit 1 and the synchronised raster toggle drives bit 3, while audio and keyboard stay zero. The raster source is a level held by dvi_tile until a control-7 write acknowledges it, so the handler must acknowledge before clearing the pending bit.",
      "evidence": [
        {
          "resource": "repo://rtl/deep16_board.sv#L277-L288",
          "version": "repo-lines-v1:sha256:6beb7185b8d5e84b708c9fef9977fd8d0a5756d02533a5a878c7b5b7da7a52db:"
