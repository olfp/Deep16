        }
      ]
    },
    {
      "id": "claim_78b2436f60d54252b9404301e6377cc6",
      "statement": "The top level decodes the tilemap at 0xF1000-0xF1853, controls at 0xF2000-0xF200E, the 128-tile bank at 0xF3000-0xF3FFF, 24 sprite groups at 0xF4000-0xF57FF, and 64 OAM descriptors plus 8 palette sets at 0xF6000-0xF627F.",
      "evidence": [
        {
          "resource": "repo://rtl/deep16_top.sv#L600-L670",
          "version": "repo-lines-v1:sha256:eaebbb7468c2f70e122f91ede2885c4a5031afd8b8290eb1812b785554548fba:"
        }
      ]
    },
    {
      "id": "claim_66a6e97d74cb4f319a8eac9b53c40cbc",
      "statement": "The FiT CPU windows are write-through to both the tile engine and the PSRAM/Forth mirror; the tilemap, controls, tile bank, sprite bank and the shared OAM/palette window each decode a distinct address range.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L343-L344",
          "version": "repo-lines-v1:sha256:8240e558d3aa13096356005c00c1557de3ee3e7cf899ab7119811b869f49699e:"
