  "claims": [
    {
      "id": "claim_c891314301634162a885022e2c7dd858",
      "statement": "dvi_text is not a framebuffer: it listens to the CPU's uart_txd line, keeps an 80x24 cell image, renders 640x360 centred in 640x480 at 60 Hz, and costs two BSRAM blocks (960 words of cells, 768-word font).",
      "evidence": [
        {
          "resource": "repo://rtl/dvi/dvi_text.sv#L1-L20",
          "version": "repo-lines-v1:sha256:f5f497a2507412afa49ee81b6a8e246fabb0bb4326cdd3ee9785a3063f7e98be:"
        }
      ]
    },
    {
      "id": "claim_a1928302dcea4fd98cb4dc8e67479a67",
      "statement": "The text mirror's parser handles CR, LF, BS, printable ASCII, ESC[H, ESC[r;cH, ESC[2J/3J and ESC[K, ignores SGR, treats ?1049 as clear-and-home, and defers scrolling to vertical blanking.",
      "evidence": [
        {
          "resource": "repo://rtl/dvi/dvi_text.sv#L13-L19",
          "version": "repo-lines-v1:sha256:38075510dabb0e9ab7283de36a9b70aeb9bb296a1da2d39fc0d293eb4627ffeb:"
        }
      ]
    },
    {
      "id": "claim_3ee705991b54402bb5e02ab397ff3238",
      "statement": "dvi_tile renders 80x24 cells of 8x15 pixels at 24.75 MHz into line buffers and scans them out as 1280x720 at 60 Hz, using an 82x26 tilemap, 128 tiles of 32 words, a 24-group sprite bank, 64 OAM descriptors and 8 palette sets.",
      "evidence": [
        {
          "resource": "repo://MEMMAP.md#L358-L370",
          "version": "repo-lines-v1:sha256:0436c4db05d98406ba589983df57e102849dadbd51a0f8b71bfd5b78bd2fb629:"
        },
        {
          "resource": "repo://rtl/dvi/dvi_tile.sv#L1-L35",
          "version": "repo-lines-v1:sha256:828b2696ee96b6d417915acedd33fca554a886adde01da547796290a2ea36540:"
        },
        {
          "resource": "repo://rtl/dvi/dvi_tile.sv#L97-L110",
          "version": "repo-lines-v1:sha256:ab6d8a7975dddf2a2b0f6471f03477095468b34b2a7ed780a6e1041a679c811c:"
        }
      ]
    },
    {
      "id": "claim_73a1fa57752c493386f107be5a027709",
      "statement": "The renderer keeps the tilemap, tile bank, sprite bank, line buffer and a shared OAM/palette scene RAM in BSRAM; the palettes are no longer distributed logic.",
      "evidence": [
        {
          "resource": "repo://rtl/dvi/dvi_tile.sv#L200-L215",
          "version": "repo-lines-v1:sha256:3179d86e8bcbbb205c771b1862683d07f41fc68c0f3d83c0bd76a3ab17347ee6:"
        },
        {
