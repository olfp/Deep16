# Rust build artifacts
target/
**/target/

# Node
node_modules/

# OS noise
.DS_Store
Thumbs.db

# Editor / tooling
*.swp
.vscode/
.idea/

# Screenshots from scripts/ui-shot.mjs (npm run ui:shot)
artifacts/

# The compiled WASM core in wasm/pkg/ is intentionally NOT ignored:
# index.html loads wasm/pkg/deep16_wasm.js and wasm/pkg/deep16_wasm_bg.wasm
# directly, so the browser IDE works without a local Rust build.
# Verilator build directories (the generated WASM package in rtl/pkg/ is
# intentionally NOT ignored - like wasm/pkg/ it is committed so the IDE and the
# tests run without a local build)
obj_dir/
obj_board/
rtl/obj_wasm/
build/

# Gowin EDA project output. fpga/gowin/deep16_board.gprj is committed (the
# device, file list and D16MINI define); the generated impl/ tree and the
# per-user state are not.
fpga/gowin/impl/
fpga/gowin/src/
fpga/gowin/*.gprj.user

# Verilator build dir for the PSRAM bridge test
obj_psram/
obj_psram_word/
obj_psram_boot/
obj_uart_fifo/
obj_dvi_text/
obj_tmds/
