-- LILA file-loader test program
fx = 2
fy = fx + 3
print(fy)

if fx > 0 then
  fsum = 0
  fi = 0
  while fi < 3 do
    fsum = fsum + fi
    fi = fi + 1
  end
else
  fsum = -1
end
print(fsum)

if fx < 0 then fneg = 1 else fneg = 0 end
print(fneg)

-- nested multi-line blocks: if inside while
fmax = 0
fj = 0
while fj < 3 do
  if fj > fmax then
    fmax = fj
  end
  fj = fj + 1
end
print(fmax)

-- elseif chain
fcase = 2
if fcase = 1 then
  fgrade = 10
elseif fcase = 2 then
  fgrade = 20
elseif fcase = 3 then
  fgrade = 30
else
  fgrade = 40
end
print(fgrade)

-- for loops, including a step
ffor = 0
for fk = 1, 3 do
  ffor = ffor + fk
end
print(ffor)

fstep = 0
for fk = 1, 5, 2 do
  fstep = fstep + fk
end
print(fstep)

-- negative step
fdown = 0
for fk = 3, 1, -1 do
  fdown = fdown + fk
end
print(fdown)

-- changing the loop variable changes the next iteration
fmod = 0
for fk = 1, 10 do
  if fk = 3 then
    fk = 8
  end
  fmod = fmod + 1
end
print(fmod)

-- single-line for
fsingle = 0
for fk = 1, 3 do fsingle = fsingle + fk end
print(fsingle)

-- nested for
fnest = 0
for fa = 1, 2 do
  for fb = 1, 2 do
    fnest = fnest + fa * fb
  end
end
print(fnest)

-- parenthesized expressions and unary minus
fparen = (1 + 2) * (3 + 4)
print(fparen)

fprec = 2 * (3 + 4) - 5
print(fprec)

fnegexpr = -(1 + 2)
print(fnegexpr)

if (fx + 1) > 2 then
  fcond = 1
else
  fcond = 0
end
print(fcond)

-- parentheses in for bounds
frange = 0
for fp = (1), (2 + 2) do
  frange = frange + fp
end
print(frange)

-- break out of a while loop
fbrk = 0
while fbrk < 10 do
  fbrk = fbrk + 1
  if fbrk = 3 then
    break
  end
end
print(fbrk)

-- break out of a for loop
fbsum = 0
for fbi = 1, 10 do
  if fbi = 4 then
    break
  end
  fbsum = fbsum + fbi
end
print(fbsum)

-- break only exits the inner loop
fbnest = 0
for fa = 1, 3 do
  for fb2 = 1, 3 do
    if fb2 = 2 then
      break
    end
    fbnest = fbnest + 1
  end
  fbnest = fbnest + 10
end
print(fbnest)

-- break in a single-line loop body
fbsingle = 0
while fbsingle < 10 do fbsingle = fbsingle + 1 ; break end
print(fbsingle)

-- functions: parameters, return, nested calls
function fadd(a, b)
  return a + b
end
ffnadd = fadd(2, 3)
print(ffnadd)          -- 5

function fdouble(v)
  return v * 2
end
function fquad(v)
  return fdouble(fdouble(v))
end
ffnquad = fquad(3)
print(ffnquad)         -- 12

function fsumto(n)
  acc = 0
  for k = 1, n do
    acc = acc + k
  end
  return acc
end
ffnsum = fsumto(4)
print(ffnsum)          -- 10

-- return out of a while loop
function ffirstbig(limit)
  i = 0
  while i < 10 do
    i = i + 1
    if i > limit then
      return i
    end
  end
  return -1
end
ffnfirst = ffirstbig(3)
print(ffnfirst)        -- 4

-- return out of an if/elseif chain
function fclassify(n)
  if n > 0 then
    return 1
  elseif n < 0 then
    return -1
  end
  return 0
end
ffnclass = fclassify(-9)
print(ffnclass)        -- -1

-- return out of a for loop
function ffindstop(n)
  for j = 1, 10 do
    if j = n then
      return j * 100
    end
  end
  return 0
end
ffnfind = ffindstop(4)
print(ffnfind)         -- 400

-- break inside a function loop
function fbreaksum(n)
  acc = 0
  for k = 1, 10 do
    if k = n then
      break
    end
    acc = acc + k
  end
  return acc
end
ffnbrk = fbreaksum(4)
print(ffnbrk)          -- 6

-- procedure: no return yields nil
function faddto(n)
  fntotal = fntotal + n
end
fntotal = 0
faddto(5)
faddto(2)
print(fntotal)         -- 7
ffnproc = faddto(1)
print(ffnproc)         -- nil
ffnfinal = fntotal     -- 8

-- zero-argument function with an empty body yields nil
function fnothing()
end
ffnnothing = fnothing()
print(ffnnothing)      -- nil

-- a function may be called before its definition in the source
ffnlater = flater(6)
print(ffnlater)        -- 7
function flater(v)
  return v + 1
end

-- tables: string keys, missing keys (nil), overwrite, aliasing, mixed tags
ft = {}
ft["a"] = 5
ft["b"] = 7
ftabsum = ft["a"] + ft["b"]
print(ftabsum)          -- 12
ftabmiss = ft["nope"]
print(ftabmiss)         -- nil
ft["a"] = 9
print(ft["a"])          -- 9
ftalias = ft
print(ftalias["b"])     -- 7
ft["hello world"] = 11
print(ft["hello world"]) -- 11
ft[""] = 3
print(ft[""])           -- 3

-- nested tables through an intermediate variable
fouter = {}
finner = {}
fouter["inner"] = finner
finner["x"] = 4
fnested = fouter["inner"]["x"]
print(fnested)          -- 4

-- tables as function parameters
function fgetx(tbl)
  return tbl["x"]
end
function fputx(tbl, v)
  tbl["x"] = v
end
fputx(finner, 8)
fparam = fgetx(finner)
print(fparam)           -- 8

-- strings: literals, variables, table keys
fstr = "hello"
print(fstr)
fstr2 = fstr
print(fstr2)
ft[fstr] = 21
print(ft[fstr])         -- 21
print(ft["hello"])      -- 21
fstr = "world"
print(fstr)
print(ft["hello"])      -- 21
print("dash -- inside")

-- string expressions: concatenation, length, comparison
fgreet = "hello" + ", " + fstr
print(fgreet)            -- hello, world
print(length(fgreet))    -- 12
print(len(""))           -- 0
print("abc" = "abc")     -- true
print("abc" = "abd")     -- false
print("abc" < "abd")     -- true
print("b" > "a")         -- true
if fstr = "world" then
  fmatch = 1
else
  fmatch = 0
end
print(fmatch)            -- 1
fmsg = "n=" + "42"
print(fmsg)              -- n=42
print(length(fmsg) + 1)  -- 5
fmsg = fmsg + "!"
fcopy = fmsg
print(fcopy)             -- n=42!
ft["k" + "2"] = 17
print(ft["k2"])          -- 17

-- string parameters and string results
function fgreet2(name$)
  return "hello, " + name$
end
ffnstr = fgreet2("lila")
print(ffnstr)              -- hello, lila

function fshout(msg$)
  return msg$ + "!"
end
ffnshout = fshout(fgreet2("world"))
print(ffnshout)            -- hello, world!

function fecho2(a$, n)
  return a$ + a$
end
ffe = fecho2("ab", 2)
print(ffe)                 -- abab

function fexclaim(s$)
  s$ = s$ + "!"
  return s$
end
ffex = fexclaim("hey")
print(ffex)                -- hey!

function fzed()
  return "zed"
end
ffzed = fzed()
print(ffzed)               -- zed
fzed()                     -- string result discarded

print(fgreet2("x"))        -- hello, x

-- strings as table values
fnames = {}
fnames["first"] = "alice"
print(fnames["first"])          -- alice
print(length(fnames["first"]))  -- 5
fnames["first"] = fnames["first"] + "!"
print(fnames["first"])          -- alice!
fnamecopy = fnames
ffncopyname = fnamecopy["first"]
print(ffncopyname)              -- alice!
fmissinglength = length(fnames["missing"])
print(fmissinglength)           -- 0
ffnfullname = fnames["first"] + "?"
print(ffnfullname)              -- alice!?
if fnames["first"] = "alice!" then
  ffnnameok = 1
else
  ffnnameok = 0
end
print(ffnnameok)                -- 1

-- a function writing a string into a table parameter
function fputstr(tbl, s$)
  tbl["value"] = s$
end
fmarked = {}
fmarked["kind"] = "string"
fputstr(fmarked, "bob")
print(fmarked["value"])         -- bob
print(length(fmarked["value"])) -- 3

-- locals are block scoped and may shadow globals and outer locals
lx = 1
local ly = lx + 1
flbase = ly
print(ly)                       -- 2
if true then
  local ly = 3
  flinner = ly
end
flouter = ly

-- local functions can recurse through their own local name
local function lfact(n)
  if n < 2 then
    return 1
  end
  return n * lfact(n - 1)
end
flfact = lfact(5)
print(flfact)                   -- 120

-- global functions recurse through the global binding
function lfib(n)
  if n < 2 then
    return n
  end
  return lfib(n - 1) + lfib(n - 2)
end
flfib = lfib(10)
print(flfib)                    -- 55

-- a closure keeps the defining frame alive after the call returns
function lmakecounter(start)
  local n = start
  local function step()
    n = n + 1
    return n
  end
  return step
end
lc1 = lmakecounter(0)
flca = lc1()
flcb = lc1()
lc2 = lmakecounter(10)
flcc = lc2()
flcd = lc1()
print(flca)                     -- 1
print(flcb)                     -- 2
print(flcc)                     -- 11
print(flcd)                     -- 3

-- an anonymous function captures the enclosing parameter
function lmakeadder(a)
  local add = function(b) return a + b end
  return add
end
ladder = lmakeadder(10)
fladder = ladder(5)
print(fladder)                  -- 15

-- function values can be passed as arguments and compared for identity
function ldbl(x) return x * 2 end
function lapply(fn, v) return fn(v) end
flapply = lapply(ldbl, 21)
flsame = ldbl = ldbl
flother = ldbl = lfib
print(flapply)                  -- 42
print(flsame)                   -- true
print(flother)                  -- false

-- boolean/logical operators and the Lua-like operator set
op_and_val = true and 5
op_and_false = false and 5
op_and_nil = nil and 5
op_and_str = true and "yes"
op_or_val = false or 7
op_or_true = true or 7
op_or_nil = nil or 3
op_or_zero = 0 or 5
op_not_true = not true
op_not_false = not false
op_not_nil = not nil
print(op_and_val)               -- 5
print(op_and_false)             -- false
print(op_and_nil)               -- nil
print(op_and_str)               -- yes
print(op_or_val)                -- 7
print(op_or_true)               -- true
print(op_or_nil)                -- 3
print(op_or_zero)               -- 5
print(op_not_true)              -- false
print(op_not_false)             -- true
print(op_not_nil)               -- true

-- and/or short-circuit: the unused side must not run
opcalls = 0
function optick(v)
  opcalls = opcalls + 1
  return v
end
opshort1 = false and optick(99)
opshort2 = true or optick(98)
opshort3 = true and optick(97)
opshort4 = false or optick(96)
print(opshort1)                 -- false
print(opshort2)                 -- true
print(opshort3)                 -- 97
print(opshort4)                 -- 96
print(opcalls)                  -- 2

-- comparisons produce booleans
op_eq = 3 == 3
op_ne = 3 ~= 4
op_le = 3 <= 3
op_ge = 4 >= 3
op_lt = 3 < 2
op_str_le = "abc" <= "abc"
op_str_ge = "b" >= "a"
op_str_ne = "abc" ~= "abd"
print(op_eq)                    -- true
print(op_ne)                    -- true
print(op_le)                    -- true
print(op_ge)                    -- true
print(op_lt)                    -- false
print(op_str_le)                -- true
print(op_str_ge)                -- true
print(op_str_ne)                -- true

-- modulo, floor division, and power
op_mod = 7 % 4
op_mod_neg = -7 % 4
op_mod_div_neg = 7 % -4
op_idiv = 7 // 2
op_idiv_neg = -7 // 2
op_idiv_div_neg = 7 // -2
op_pow = 2 ^ 10
print(op_mod)                   -- 3
print(op_mod_neg)               -- 1
print(op_mod_div_neg)           -- -1
print(op_idiv)                  -- 3
print(op_idiv_neg)              -- -4
print(op_idiv_div_neg)          -- -4
print(op_pow)                   -- 1024

-- operator precedence: ^ is right-associative and binds tighter than unary -
op_prec = 1 + 2 * 3 ^ 2
op_rpow = 2 ^ 3 ^ 2
op_negpow = -2 ^ 2
print(op_prec)                  -- 19
print(op_rpow)                  -- 512
print(op_negpow)                -- -4

-- and/or/not in conditions
if 1 > 0 and 2 > 1 then op_cond1 = 1 else op_cond1 = 0 end
if 1 > 0 and 2 < 1 then op_cond2 = 1 else op_cond2 = 0 end
if 1 < 0 or 2 > 1 then op_cond3 = 1 else op_cond3 = 0 end
if not (1 > 2) then op_cond4 = 1 else op_cond4 = 0 end
print(op_cond1)                 -- 1
print(op_cond2)                 -- 0
print(op_cond3)                 -- 1
print(op_cond4)                 -- 1

-- short-circuiting also suppresses division by zero
op_short_zero1 = false and 1 / 0
op_short_zero2 = true or 1 / 0
print(op_short_zero1)           -- false
print(op_short_zero2)           -- true

-- multiple returns and varargs
function mret2()
  return 10, 20
end
function mret3()
  return 1, 2, 3
end
mra, mrb = mret2()
print(mra)                      -- 10
print(mrb)                      -- 20
mrc = mret2()
print(mrc)                      -- 10
mrx, mry, mrz = mret3()
print(mrx)                      -- 1
print(mry)                      -- 2
print(mrz)                      -- 3

-- multi assignment swap and local multi
msa = 7
msb = 8
msa, msb = msb, msa
print(msa)                      -- 8
print(msb)                      -- 7
local mla, mlb = mret2()
print(mla)                      -- 10
print(mlb)                      -- 20
mlsum = mla + mlb
print(mlsum)                    -- 30

-- varargs, select, and print
function msum(...)
  local total = 0
  local i = 1
  local n = select("#", ...)
  while i <= n do
    total = total + select(i, ...)
    i = i + 1
  end
  return total
end
print(msum(1, 2, 3, 4))         -- 10
print(msum())                   -- 0
function mseln(...)
  return select("#", ...)
end
function msel2(...)
  return select(2, ...)
end
print(mseln(5, 6, 7))           -- 3
print(msel2(5, 6, 7))           -- 6

function mshow(...)
  print(...)
end
mshow(4, 5, 6)                  -- 456

-- return forwarding and spread
function mtail(...)
  return ...
end
mta, mtb = mtail(11, 12)
print(mta)                      -- 11
print(mtb)                      -- 12
function mpassthru(...)
  return msum(...)
end
print(mpassthru(2, 3, 4))       -- 9
function mfirst(...)
  return select(1, ...)
end
print(mfirst(99, 100))          -- 99

-- minimal standard library: type, conversion, strings, math, errors
std_type_num = type(1)
std_type_str = type("x")
std_type_bool = type(true)
std_type_nil = type(nil)
std_type_table = type({})
std_type_fn = type(type)
print(std_type_num)             -- number
print(std_type_str)             -- string
print(std_type_bool)            -- boolean
print(std_type_nil)             -- nil
print(std_type_table)           -- table
print(std_type_fn)              -- function

std_numstr = tostring(-45)
std_boolstr = tostring(true)
std_nilstr = tostring(nil)
std_tonum = tonumber(" 42 ")
std_tonum_hex = tonumber("0x1f")
std_tonum_bad = tonumber("nope")
print(std_numstr)               -- -45
print(std_boolstr)              -- true
print(std_nilstr)               -- nil
print(std_tonum)                -- 42
print(std_tonum_hex)            -- 31
print(std_tonum_bad)            -- nil

std_sub = string.sub("abcdef", 2, 4)
std_sub_neg = string.sub("abcdef", -2)
std_upper = string.upper("MiXeD")
std_lower = string.lower("MiXeD")
std_rep = string.rep("ab", 3)
std_rev = string.reverse("abc")
std_len = string.len("hello")
std_byte = string.byte("abc", 2)
std_char = string.char(65, 66, 67)
print(std_sub)                  -- bcd
print(std_sub_neg)              -- ef
print(std_upper)                -- MIXED
print(std_lower)                -- mixed
print(std_rep)                  -- ababab
print(std_rev)                  -- cba
print(std_len)                  -- 5
print(std_byte)                 -- 98
print(std_char)                 -- ABC

std_abs = math.abs(-9)
std_max = math.max(3, 9, 4)
std_min = math.min(3, 9, 4)
std_mtype = math.type(7)
std_toint = math.tointeger(5)
std_maxint = math.maxinteger
std_minint = math.mininteger
print(std_abs)                  -- 9
print(std_max)                  -- 9
print(std_min)                  -- 3
print(std_mtype)                -- integer
print(std_toint)                -- 5
print(std_maxint)               -- 2147483647
print(std_minint)               -- -2147483648

-- builtins are first-class closures
std_first = tostring
std_firstout = std_first(88)
print(std_firstout)             -- 88

-- error/assert/pcall
function std_add(a, b) return a + b end
std_pok, std_pval = pcall(std_add, 2, 3)
print(std_pok, std_pval)        -- true 5

function std_boom() error("boom") end
std_perr, std_pmsg = pcall(std_boom)
print(std_perr, std_pmsg)       -- false boom

function std_badarg(v) return v + 1 end
std_pbad, std_pbadmsg = pcall(std_badarg, "x")
print(std_pbad, std_pbadmsg)    -- false lila: cannot add these values

function std_failassert() assert(false, "nope") end
std_pas, std_pamsg = pcall(std_failassert)
print(std_pas, std_pamsg)       -- false nope

std_assertval = assert(5)
std_ax, std_ay = assert(1, 2)
print(std_assertval, std_ax, std_ay)  -- 5 1 2

-- pcall with no callable first argument returns an error instead of hanging
std_pnone, std_pnonemsg = pcall()
print(std_pnone, std_pnonemsg)  -- false lila: function expected

-- metatables: __index, __newindex, arithmetic, comparisons, __tostring
function mtaddf(a, b) return 40 + 2 end
function mtsubf(a, b) return 100 end
function mtmulf(a, b) return 21 end
function mtdivf(a, b) return 5 end
function mtfloorf(a, b) return 99 end
function mtunmf(a) return -7 end
function mteqf(a, b) return true end
function mtltf(a, b) return true end
function mtlef(a, b) return true end
function mtstrf(a) return "MOBJ" end

mops = {}
mops["__add"] = mtaddf
mops["__sub"] = mtsubf
mops["__mul"] = mtmulf
mops["__div"] = mtdivf
mops["__idiv"] = mtfloorf
mops["__mod"] = mtfloorf
mops["__pow"] = mtfloorf
mops["__unm"] = mtunmf
mops["__tostring"] = mtstrf
mopv = {}
setmetatable(mopv, mops)

mt_add = mopv + 1
mt_radd = 1 + mopv
mt_sub = mopv - 2
mt_mul = mopv * 3
mt_div = mopv / 4
mt_idiv = mopv // 5
mt_mod = mopv % 6
mt_pow = mopv ^ 7
mt_unm = -mopv
mt_tostr = tostring(mopv)
print(mopv)

mbase = {}
mbase["x"] = 7
mindexmt = {}
mindexmt["__index"] = mbase
mitem = {}
setmetatable(mitem, mindexmt)
mt_idx = mitem["x"]
mt_missing = mitem["absent"]

function mtfidx(t, k) return "fn:" + k end
mfindmt = {}
mfindmt["__index"] = mtfidx
mfitem = {}
setmetatable(mfitem, mfindmt)
mt_fnidx = mfitem["key"]

ml2 = {}
ml2["deep"] = 3
ml2mt = {}
ml2mt["__index"] = ml2
ml1 = {}
setmetatable(ml1, ml2mt)
ml1mt = {}
ml1mt["__index"] = ml1
mtop = {}
setmetatable(mtop, ml1mt)
mt_chain = mtop["deep"]

function mtnewf(t, k, v) mt_seen = k end
mnewmt = {}
mnewmt["__newindex"] = mtnewf
mnewt = {}
setmetatable(mnewt, mnewmt)
mnewt["a"] = 1
mt_rawmiss = rawget(mnewt, "a")
rawset(mnewt, "a", 2)
mt_rawa = rawget(mnewt, "a")
mt_plain_a = mnewt["a"]

mnewbase = {}
mnewtabmt = {}
mnewtabmt["__newindex"] = mnewbase
mnewtab = {}
setmetatable(mnewtab, mnewtabmt)
mnewtab["z"] = 5
mt_newtable = rawget(mnewbase, "z")

meqmt = {}
meqmt["__eq"] = mteqf
meqmt["__lt"] = mtltf
meqmt["__le"] = mtlef
me1 = {}
me2 = {}
setmetatable(me1, meqmt)
setmetatable(me2, meqmt)
mt_eq = me1 == me2
mt_selfeq = me1 == me1
mt_lt = me1 < me2
mt_rlt = 1 < me2
mt_le = me1 <= me2
mt_gt = me1 > me2
mt_ge = me1 >= me2
mt_raweq1 = rawequal(me1, me1)
mt_raweq2 = rawequal(me1, me2)

mt_gm = getmetatable(mopv) == mops
mt_unset = setmetatable(mopv, nil) == mopv
mt_gmnil = getmetatable(mopv)
mt_badset, mt_badmsg = pcall(setmetatable, 5, {})
