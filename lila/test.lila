-- LILA file-loader test program
fx = 2
fy = fx + 3
print(fy)

if fx > 0 then
  fsum = 0
  fi = 0
  while fi < 3 do
    fsum = fsum + fi
    fi = fi + 1
  end
else
  fsum = -1
end
print(fsum)

if fx < 0 then fneg = 1 else fneg = 0 end
print(fneg)

-- nested multi-line blocks: if inside while
fmax = 0
fj = 0
while fj < 3 do
  if fj > fmax then
    fmax = fj
  end
  fj = fj + 1
end
print(fmax)

-- elseif chain
fcase = 2
if fcase = 1 then
  fgrade = 10
elseif fcase = 2 then
  fgrade = 20
elseif fcase = 3 then
  fgrade = 30
else
  fgrade = 40
end
print(fgrade)

-- for loops, including a step
ffor = 0
for fk = 1, 3 do
  ffor = ffor + fk
end
print(ffor)

fstep = 0
for fk = 1, 5, 2 do
  fstep = fstep + fk
end
print(fstep)

-- negative step
fdown = 0
for fk = 3, 1, -1 do
  fdown = fdown + fk
end
print(fdown)

-- changing the loop variable changes the next iteration
fmod = 0
for fk = 1, 10 do
  if fk = 3 then
    fk = 8
  end
  fmod = fmod + 1
end
print(fmod)

-- single-line for
fsingle = 0
for fk = 1, 3 do fsingle = fsingle + fk end
print(fsingle)

-- nested for
fnest = 0
for fa = 1, 2 do
  for fb = 1, 2 do
    fnest = fnest + fa * fb
  end
end
print(fnest)

-- parenthesized expressions and unary minus
fparen = (1 + 2) * (3 + 4)
print(fparen)

fprec = 2 * (3 + 4) - 5
print(fprec)

fnegexpr = -(1 + 2)
print(fnegexpr)

if (fx + 1) > 2 then
  fcond = 1
else
  fcond = 0
end
print(fcond)

-- parentheses in for bounds
frange = 0
for fp = (1), (2 + 2) do
  frange = frange + fp
end
print(frange)

-- break out of a while loop
fbrk = 0
while fbrk < 10 do
  fbrk = fbrk + 1
  if fbrk = 3 then
    break
  end
end
print(fbrk)

-- break out of a for loop
fbsum = 0
for fbi = 1, 10 do
  if fbi = 4 then
    break
  end
  fbsum = fbsum + fbi
end
print(fbsum)

-- break only exits the inner loop
fbnest = 0
for fa = 1, 3 do
  for fb2 = 1, 3 do
    if fb2 = 2 then
      break
    end
    fbnest = fbnest + 1
  end
  fbnest = fbnest + 10
end
print(fbnest)

-- break in a single-line loop body
fbsingle = 0
while fbsingle < 10 do fbsingle = fbsingle + 1 ; break end
print(fbsingle)

-- functions: parameters, return, nested calls
function fadd(a, b)
  return a + b
end
ffnadd = fadd(2, 3)
print(ffnadd)          -- 5

function fdouble(v)
  return v * 2
end
function fquad(v)
  return fdouble(fdouble(v))
end
ffnquad = fquad(3)
print(ffnquad)         -- 12

function fsumto(n)
  acc = 0
  for k = 1, n do
    acc = acc + k
  end
  return acc
end
ffnsum = fsumto(4)
print(ffnsum)          -- 10

-- return out of a while loop
function ffirstbig(limit)
  i = 0
  while i < 10 do
    i = i + 1
    if i > limit then
      return i
    end
  end
  return -1
end
ffnfirst = ffirstbig(3)
print(ffnfirst)        -- 4

-- return out of an if/elseif chain
function fclassify(n)
  if n > 0 then
    return 1
  elseif n < 0 then
    return -1
  end
  return 0
end
ffnclass = fclassify(-9)
print(ffnclass)        -- -1

-- return out of a for loop
function ffindstop(n)
  for j = 1, 10 do
    if j = n then
      return j * 100
    end
  end
  return 0
end
ffnfind = ffindstop(4)
print(ffnfind)         -- 400

-- break inside a function loop
function fbreaksum(n)
  acc = 0
  for k = 1, 10 do
    if k = n then
      break
    end
    acc = acc + k
  end
  return acc
end
ffnbrk = fbreaksum(4)
print(ffnbrk)          -- 6

-- procedure: no return yields 0
function faddto(n)
  fntotal = fntotal + n
end
fntotal = 0
faddto(5)
faddto(2)
print(fntotal)         -- 7
ffnproc = faddto(1)
print(ffnproc)         -- 0
ffnfinal = fntotal     -- 8

-- zero-argument function with an empty body
function fnothing()
end
ffnnothing = fnothing()
print(ffnnothing)      -- 0

-- a function may be called before its definition in the source
ffnlater = flater(6)
print(ffnlater)        -- 7
function flater(v)
  return v + 1
end

-- tables: string keys, missing keys, overwrite, aliasing
ft = {}
ft["a"] = 5
ft["b"] = 7
ftabsum = ft["a"] + ft["b"]
print(ftabsum)          -- 12
ftabmiss = ft["nope"]
print(ftabmiss)         -- 0
ft["a"] = 9
print(ft["a"])          -- 9
ftalias = ft
print(ftalias["b"])     -- 7
ft["hello world"] = 11
print(ft["hello world"]) -- 11
ft[""] = 3
print(ft[""])           -- 3

-- nested tables through an intermediate variable
fouter = {}
finner = {}
fouter["inner"] = finner
finner["x"] = 4
fnested = fouter["inner"]["x"]
print(fnested)          -- 4

-- tables as function parameters
function fgetx(tbl)
  return tbl["x"]
end
function fputx(tbl, v)
  tbl["x"] = v
end
fputx(finner, 8)
fparam = fgetx(finner)
print(fparam)           -- 8

-- strings: literals, variables, table keys
fstr = "hello"
print(fstr)
fstr2 = fstr
print(fstr2)
ft[fstr] = 21
print(ft[fstr])         -- 21
print(ft["hello"])      -- 21
fstr = "world"
print(fstr)
print(ft["hello"])      -- 21
print("dash -- inside")
