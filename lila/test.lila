-- LILA file-loader test program
fx = 2
fy = fx + 3
print(fy)

if fx > 0 then
  fsum = 0
  fi = 0
  while fi < 3 do
    fsum = fsum + fi
    fi = fi + 1
  end
else
  fsum = -1
end
print(fsum)

if fx < 0 then fneg = 1 else fneg = 0 end
print(fneg)

-- nested multi-line blocks: if inside while
fmax = 0
fj = 0
while fj < 3 do
  if fj > fmax then
    fmax = fj
  end
  fj = fj + 1
end
print(fmax)

-- elseif chain
fcase = 2
if fcase = 1 then
  fgrade = 10
elseif fcase = 2 then
  fgrade = 20
elseif fcase = 3 then
  fgrade = 30
else
  fgrade = 40
end
print(fgrade)

-- for loops, including a step
ffor = 0
for fk = 1, 3 do
  ffor = ffor + fk
end
print(ffor)

fstep = 0
for fk = 1, 5, 2 do
  fstep = fstep + fk
end
print(fstep)

-- negative step
fdown = 0
for fk = 3, 1, -1 do
  fdown = fdown + fk
end
print(fdown)

-- changing the loop variable changes the next iteration
fmod = 0
for fk = 1, 10 do
  if fk = 3 then
    fk = 8
  end
  fmod = fmod + 1
end
print(fmod)

-- single-line for
fsingle = 0
for fk = 1, 3 do fsingle = fsingle + fk end
print(fsingle)

-- nested for
fnest = 0
for fa = 1, 2 do
  for fb = 1, 2 do
    fnest = fnest + fa * fb
  end
end
print(fnest)

-- parenthesized expressions and unary minus
fparen = (1 + 2) * (3 + 4)
print(fparen)

fprec = 2 * (3 + 4) - 5
print(fprec)

fnegexpr = -(1 + 2)
print(fnegexpr)

if (fx + 1) > 2 then
  fcond = 1
else
  fcond = 0
end
print(fcond)

-- parentheses in for bounds
frange = 0
for fp = (1), (2 + 2) do
  frange = frange + fp
end
print(frange)

-- break out of a while loop
fbrk = 0
while fbrk < 10 do
  fbrk = fbrk + 1
  if fbrk = 3 then
    break
  end
end
print(fbrk)

-- break out of a for loop
fbsum = 0
for fbi = 1, 10 do
  if fbi = 4 then
    break
  end
  fbsum = fbsum + fbi
end
print(fbsum)

-- break only exits the inner loop
fbnest = 0
for fa = 1, 3 do
  for fb2 = 1, 3 do
    if fb2 = 2 then
      break
    end
    fbnest = fbnest + 1
  end
  fbnest = fbnest + 10
end
print(fbnest)

-- break in a single-line loop body
fbsingle = 0
while fbsingle < 10 do fbsingle = fbsingle + 1 ; break end
print(fbsingle)
