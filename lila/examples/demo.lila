-- LILA demo: expressions, control flow, functions, tables, and strings
x = 5
y = (x + 1) * 2 - 1
print(y)

if x = 5 then
  print(100)
elseif x > 5 then
  print(200)
else
  print(0)
end

n = 0
sum = 0
while n < 4 do
  sum = sum + n
  n = n + 1
end
print(sum)

total = 0
for i = 1, 10 do
  if i = 5 then
    break
  end
  total = total + i
end
print(total)

-- functions and procedures
function square(v)
  return v * v
end
print(square(7))

function addto(v)
  total = total + v
end
addto(5)
print(total)

-- tables and strings
scores = {}
scores["alice"] = 10
scores["bob"] = 7
print(scores["alice"] + scores["bob"])

name = "lila"
print(name)
message = "hello, " + name
print(message)
print(length(message))

-- string parameters and string results
function greet(who$)
  return "hello, " + who$
end
print(greet("world"))

function exclaim(s$)
  s$ = s$ + "!"
  return s$
end
print(exclaim("hey"))

-- strings as table values
people = {}
people["first"] = "alice"
print(people["first"])
print(length(people["first"]))
people["first"] = people["first"] + "!"
print(people["first"] + "?")

function putname(tbl, s$)
  tbl["value"] = s$
end
putname(people, "bob")
print(people["value"])
