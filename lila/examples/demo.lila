-- LILA demo: multi-line blocks, nesting, elseif, while, and for
x = 5
y = x * 2 + 1
print(y)

if x = 5 then
  print(100)
elseif x > 5 then
  print(200)
else
  print(0)
end

n = 0
sum = 0
while n < 4 do
  sum = sum + n
  n = n + 1
end
print(sum)

total = 0
for i = 1, 4 do
  total = total + i
end
print(total)
