-- LILA demo: expressions, elseif, while, for, and break
x = 5
y = (x + 1) * 2 - 1
print(y)

if x = 5 then
  print(100)
elseif x > 5 then
  print(200)
else
  print(0)
end

n = 0
sum = 0
while n < 4 do
  sum = sum + n
  n = n + 1
end
print(sum)

total = 0
for i = 1, 10 do
  if i = 5 then
    break
  end
  total = total + i
end
print(total)

-- functions and procedures
function square(v)
  return v * v
end
print(square(7))

function addto(v)
  total = total + v
end
addto(5)
print(total)

-- tables and strings
scores = {}
scores["alice"] = 10
scores["bob"] = 7
print(scores["alice"] + scores["bob"])

name = "lila"
print(name)
